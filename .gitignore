# --- Rust ---
/target/
# `codepack-ai-api` is excluded from the workspace (Q41), so it builds into its own
# target directory rather than the shared one above.
/crates/codepack-ai-api/target/
**/*.rs.bk
*.pdb

# --- Tauri ---
/apps/desktop/src-tauri/target/
/apps/desktop/src-tauri/gen/

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Local environment ---
.env
.env.*
!.env.example

# Golden fixtures deliberately ship a fake `.env`: safe-export mode is supposed to
# exclude it, and the parity test is meaningless without it present. The value inside
# is a placeholder, never a real credential.
!tests/golden/fixtures/**/.env

# --- Assistant local overrides (personal, not shared) ---
.claude/settings.local.json
.codex/config.local.toml

# --- Editors and OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Build and test output ---
/coverage/
*.profraw
.pytest_cache/
__pycache__/

# --- Legacy archive is tracked on purpose ---
# docs/__arch__/ stays in git: it is the behavioral reference for the rewrite.

# Tauri writes its generated permission/capability schemas here at build time.
apps/desktop/src-tauri/gen/

# Python bytecode from the developer scripts in scripts/ (__pycache__/ is already
# covered above, with the other build and coverage output)
*.py[cod]
