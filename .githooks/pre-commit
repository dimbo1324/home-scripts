#!/usr/bin/env bash
#
# Formats staged files and re-stages them, so what lands in a commit is already
# formatted. Installed by `cargo xtask install-hooks`, which points `core.hooksPath` here.
#
# Two rules shape this script:
#
#   1. It touches **only staged files**. Running `cargo fmt --all` would reformat files
#      you left dirty on purpose, and re-staging those would pull unrelated work into the
#      commit.
#   2. It refuses to touch a file that is *partially* staged — one with both staged and
#      unstaged changes. Formatting the working copy and re-adding it would silently
#      promote the unstaged half into the commit, which is a data-loss-shaped surprise:
#      you would commit code you never staged and could not see in the diff you reviewed.
#      Those files are named and skipped instead, and the gate catches them later.
#
# Bypass once with `git commit --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# ACMR: added, copied, modified, renamed. Deletions have nothing to format.
mapfile -d '' -t staged < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ ${#staged[@]} -gt 0 ] || exit 0

# Deliberately unfiltered, unlike the staged query above: here *any* difference means the
# file is partially staged. Filtering to ACMR would miss a type change (`T`) — a file
# staged as modified and then replaced in the worktree by a symlink would pass the `-f`
# test below, get formatted through the link, and be re-staged, which is exactly the
# promotion of unstaged work that rule 2 exists to prevent.
mapfile -d '' -t unstaged < <(git diff --name-only -z)

# Built once, into an associative array, rather than scanned per candidate: the loop
# below asks this question for every staged file, so a linear search made the check
# O(staged x unstaged) — noticeable on a large commit in a large tree (audit No. 40).
# Bash 4 has `declare -A`, and both Git Bash on Windows and CI run Bash 5.
declare -A unstaged_set=()
for path in ${unstaged[@]+"${unstaged[@]}"}; do
  unstaged_set["$path"]=1
done

is_partially_staged() {
  [ -n "${unstaged_set["$1"]+set}" ]
}

rust=()
other=()
partial=()
for file in "${staged[@]}"; do
  # A rename can leave the old path in the list; only format what is actually there.
  [ -f "$file" ] || continue
  if is_partially_staged "$file"; then
    partial+=("$file")
    continue
  fi
  case "$file" in
  *.rs) rust+=("$file") ;;
  *) other+=("$file") ;;
  esac
done

# Each group is re-staged as soon as its formatter succeeds, rather than both at the end.
# If Prettier failed after rustfmt had already rewritten files, a single `git add` at the
# end would never run: those `.rs` files would be left formatted-but-unstaged, i.e.
# partially staged, and the next attempt would skip them with "format them yourself".
if [ ${#rust[@]} -gt 0 ]; then
  # `rustfmt` directly rather than `cargo fmt`, which has no way to take a file list.
  # It finds `rustfmt.toml` by walking up from each file; `--edition` is passed anyway
  # because without it rustfmt assumes 2015 and misparses current syntax.
  rustfmt --edition 2024 "${rust[@]}"
  git add -- "${rust[@]}"
fi

if [ ${#other[@]} -gt 0 ]; then
  if [ -d node_modules ]; then
    # `--ignore-unknown` skips file types Prettier has no parser for, so the list can be
    # passed as-is. `.prettierignore` still applies to explicitly named files, which is
    # what keeps the golden references and test fixtures out of reach.
    pnpm exec prettier --write --ignore-unknown --log-level warn "${other[@]}"
    git add -- "${other[@]}"
  else
    echo "pre-commit: node_modules missing, skipping Prettier (run 'pnpm install')" >&2
  fi
fi

if [ ${#partial[@]} -gt 0 ]; then
  echo "pre-commit: left these partially staged files alone, format them yourself:" >&2
  printf '  %s\n' "${partial[@]}" >&2
fi
